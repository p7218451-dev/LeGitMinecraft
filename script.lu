local slotButtons = {}

refreshDropProtectUI = function()
	for slotIndex = 1, 9 do
		local btn = slotButtons[slotIndex]
		if btn then
			local protected = Config.ProtectedSlots[slotIndex] == true
			btn.BackgroundColor3 = protected and Color3.fromRGB(38, 130, 68) or Color3.fromRGB(135, 38, 44)
			btn.TextColor3 = protected and Color3.fromRGB(220, 255, 230) or Color3.fromRGB(255, 225, 225)
		end
	end
end

for slotIndex = 1, 9 do
	local SlotBtn = Instance.new("TextButton")
	SlotBtn.Size = UDim2.new(0, 22, 0, 22)
	SlotBtn.Text = tostring(slotIndex)
	SlotBtn.Font = Enum.Font.GothamBold
	SlotBtn.TextSize = 11
	SlotBtn.AutoButtonColor = false
	SlotBtn.ZIndex = 7
	SlotBtn.Parent = HotbarRow
	Instance.new("UICorner", SlotBtn).CornerRadius = UDim.new(0, 5)
	SlotBtn.MouseButton1Click:Connect(function()
		if isUnloaded then return end
		Config.ProtectedSlots[slotIndex] = not Config.ProtectedSlots[slotIndex]
		refreshDropProtectUI()
		saveConfig()
	end)
	slotButtons[slotIndex] = SlotBtn
end
refreshDropProtectUI()

