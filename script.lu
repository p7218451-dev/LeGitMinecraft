--==================================================
-- ЦИКЛ КАДРОВ И МАКРОС ПЕРЛОВ
--==================================================
trackConnection(RunService.RenderStepped:Connect(function()
	if isUnloaded then return end
	camera = workspace.CurrentCamera

	if camera and Config.CustomFOVEnabled then
		pcall(function() camera.FieldOfView = Config.CameraFOV end)
	end

	if FOVCircleFrame and camera then
		local vp = camera.ViewportSize
		FOVCircleFrame.Position = UDim2.fromOffset(vp.X * 0.5, vp.Y * 0.5)
		FOVCircleFrame.Size = UDim2.fromOffset(Config.AimFOV * 2, Config.AimFOV * 2)
		FOVCircleFrame.Visible = Config.AimEnabled and Config.AimShowFOV and (not menuIsOpen)
	end

	if menuIsOpen then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		return
	end

	if isAimHeld() then
		local targetData, screenCenter = findBestAimTarget()
		if targetData and screenCenter then
			local deltaX = targetData.ScreenPos.X - screenCenter.X
			local deltaY = targetData.ScreenPos.Y - screenCenter.Y
			local factor = Config.AimFullyLock and 1 or math.clamp(Config.AimSmoothness / 100, 0.02, 1)
			moveMouseRelative(deltaX * factor, deltaY * factor)
		end
	else
		lockedTargetPlayer = nil
	end
end))

local function usePearlMacro()
	if isUnloaded or menuIsOpen or not Config.PearlEnabled or isPearlRunning then return end
	isPearlRunning = true

	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Nine, false, game)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Nine, false, game)
	task.wait(0.08)

	local mouseLocation = UserInputService:GetMouseLocation()
	VirtualInputManager:SendMouseButtonEvent(mouseLocation.X, mouseLocation.Y, 1, true, game, 1)
	VirtualInputManager:SendMouseButtonEvent(mouseLocation.X, mouseLocation.Y, 1, false, game, 1)
	task.wait(0.1)

	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
	currentSelectedSlot = 1
	isPearlRunning = false
end

local function toggleMenu()
	if isUnloaded or isAnimatingMenu then return end
	isAnimatingMenu = true

	local targetOpen = not menuIsOpen
	local openTweenInfo = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local closeTweenInfo = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if targetOpen then
		menuIsOpen = true
		lockedTargetPlayer = nil
		MainFrame.Visible = true
		MenuScale.Scale = 0.88

		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true

		if character then
			local tool = character:FindFirstChildOfClass("Tool")
			if tool then
				savedTool = tool
				tool.Parent = player:FindFirstChild("Backpack")
			end
		end

		local tween = TweenService:Create(MenuScale, openTweenInfo, { Scale = 1 })
		tween:Play()
		tween.Completed:Connect(function() isAnimatingMenu = false end)
	else
		menuIsOpen = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

		if savedTool and savedTool.Parent == player:FindFirstChild("Backpack") and character and humanoid then
			humanoid:EquipTool(savedTool)
		end
		savedTool = nil

		local tween = TweenService:Create(MenuScale, closeTweenInfo, { Scale = 0.88 })
		tween:Play()
		tween.Completed:Connect(function()
			if not menuIsOpen and MainFrame then MainFrame.Visible = false end
			isAnimatingMenu = false
		end)
	end
end

trackConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if isUnloaded then return end

	if isWaitingForMenuKey then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			Config.ToggleKey = input.KeyCode
			KeyButton.Text = input.KeyCode.Name
			isWaitingForMenuKey = false
			saveConfig()
			return
		end
	end

	if activeBindTarget then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			activeBindTarget.Button.Text = input.KeyCode.Name
			if activeBindTarget.Callback then activeBindTarget.Callback(input.KeyCode.Name, input.KeyCode) end
			activeBindTarget = nil
			return
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
			local name = input.UserInputType.Name
			activeBindTarget.Button.Text = name
			if activeBindTarget.Callback then activeBindTarget.Callback(name, input.UserInputType) end
			activeBindTarget = nil
			return
		end
	end

	if UserInputService:GetFocusedTextBox() ~= nil then return end

	local pressedSlot = slotKeyCodes[input.KeyCode]
	if pressedSlot then currentSelectedSlot = pressedSlot end

	if input.KeyCode == Config.ToggleKey and not isWaitingForMenuKey then
		toggleMenu()
		return
	end

	if input.KeyCode == Enum.KeyCode.Q and isCurrentSlotProtected() then return end

	if menuIsOpen or gameProcessed then
		if menuIsOpen and isMouseOverMenu() then
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
				return
			end
		end
		return
	end

	if Config.PearlEnabled then
		local isMatch = false
		if typeof(Config.PearlKey) == "EnumItem" then
			if Config.PearlKey.EnumType == Enum.KeyCode and input.KeyCode == Config.PearlKey then isMatch = true end
			if Config.PearlKey.EnumType == Enum.UserInputType and input.UserInputType == Config.PearlKey then isMatch = true end
		end
		if isMatch then
			usePearlMacro()
			return
		end
	end
end))

trackConnection(UserInputService.InputEnded:Connect(function(input)
	if isUnloaded then return end
	if isInputMatched(Config.AimKey, input) then lockedTargetPlayer = nil end
end))

print("[LeGit] Скрипт загружен (Mouse Aim Assist + Custom FOV + Ambient).")
