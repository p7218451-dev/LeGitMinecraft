	syncMaxDist(Config.AimMaxDistance)
	syncShowFOV(Config.AimShowFOV)
	syncWallCheck(Config.AimWallCheck)
	syncIgnoreTeam(Config.AimIgnoreTeam)
	refreshTargetPartButtons()
end)

