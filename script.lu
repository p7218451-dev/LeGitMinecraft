refreshWhitelistUI = function()
	if not WLScroll then return end
	for _, child in ipairs(WLScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local isIgnored = Config.WhitelistedPlayers[other.Name] == true or Config.WhitelistedPlayers[tostring(other.UserId)] == true
			local itemBtn = Instance.new("TextButton")
			itemBtn.Size = UDim2.new(1, -4, 0, 20)
			itemBtn.BackgroundColor3 = isIgnored and Color3.fromRGB(38, 130, 68) or COLORS.CardBg
			itemBtn.Text = "  " .. other.DisplayName .. " (@" .. other.Name .. ")"
			itemBtn.Font = Enum.Font.GothamBold
			itemBtn.TextSize = 9.5
			itemBtn.TextColor3 = isIgnored and Color3.fromRGB(220, 255, 230) or COLORS.TextMain
			itemBtn.TextXAlignment = Enum.TextXAlignment.Left
			itemBtn.AutoButtonColor = false
			itemBtn.ZIndex = 10
			itemBtn.Parent = WLScroll
			Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 5)
			itemBtn.MouseButton1Click:Connect(function()
				if Config.WhitelistedPlayers[other.Name] then
					Config.WhitelistedPlayers[other.Name] = nil
					Config.WhitelistedPlayers[tostring(other.UserId)] = nil
				else
					Config.WhitelistedPlayers[other.Name] = true
					Config.WhitelistedPlayers[tostring(other.UserId)] = true
					if lockedTargetPlayer == other then lockedTargetPlayer = nil end
				end
				refreshWhitelistUI()
				saveConfig()
			end)
		end
	end
end
refreshWhitelistUI()

local whitelistOpen = false
if ignoreTeamGear then
	ignoreTeamGear.MouseButton1Click:Connect(function()
		whitelistOpen = not whitelistOpen
		WhitelistPanel.Visible = whitelistOpen
		ignoreTeamGear.TextColor3 = whitelistOpen and Config.AccentColor or COLORS.TextMuted
		if whitelistOpen then refreshWhitelistUI() end
	end)
end

