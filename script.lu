local function unloadScript()
	if isUnloaded then return end
	isUnloaded = true
	menuIsOpen = false
	isMinimized = false
	isWaitingForMenuKey = false
	activeBindTarget = nil
	lockedTargetPlayer = nil

	Config.PearlEnabled = false
	Config.AimEnabled = false
	Config.AimShowFOV = false
	Config.WorldVisualsEnabled = false
	Config.ChamsEnabled = false
	Config.AmbientEnabled = false
	Config.CustomFOVEnabled = false
	Config.DropProtectEnabled = false

	if FOVCircleFrame then FOVCircleFrame.Visible = false end
	pcall(function() ContextActionService:UnbindAction(DROP_ACTION_NAME) end)
	updateWorldVisuals()
	clearAllVisualHighlights()

	if worldEffect then
		worldEffect:Destroy()
		worldEffect = nil
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if savedTool and savedTool.Parent == player:FindFirstChild("Backpack") and character and humanoid then
		pcall(function() humanoid:EquipTool(savedTool) end)
	end
	savedTool = nil

	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true

	for _, conn in ipairs(connections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(connections)

	if ScreenGui then
		ScreenGui:Destroy()
		ScreenGui = nil
	end
	print("[LeGit] Скрипт и все функции полностью отключены.")
end

CloseBtn.MouseButton1Click:Connect(unloadScript)

MinimizeBtn.MouseButton1Click:Connect(function()
	if isUnloaded then return end
	isMinimized = not isMinimized
	local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	if isMinimized then
		Sidebar.Visible = false
		ContentArea.Visible = false
		MiniLogoLabel.Visible = true
		MinimizeBtn.Text = "+"
		MainFrame.Position = MINI_POS
		TweenService:Create(MainFrame, tweenInfo, { Size = MINI_SIZE }):Play()
	else
		MiniLogoLabel.Visible = false
		MinimizeBtn.Text = "-"
		MainFrame.Position = NORMAL_POS
		local tween = TweenService:Create(MainFrame, tweenInfo, { Size = NORMAL_SIZE })
		tween:Play()
		tween.Completed:Connect(function()
			if not isMinimized and not isUnloaded then
				Sidebar.Visible = true
				ContentArea.Visible = true
			end
		end)
	end
end)

local function isMouseOverMenu()
	if not menuIsOpen or isUnloaded then return false end
	local m = UserInputService:GetMouseLocation()
	local p, s = MainFrame.AbsolutePosition, MainFrame.AbsoluteSize
	return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
end

local tabs = {}
local themeUpdaters = {}
local uiSyncCallbacks = {}

applyTheme = function()
	if isUnloaded then return end
	COLORS = BaseTheme
	MainFrame.BackgroundColor3 = COLORS.MainBg
	MainStroke.Color = COLORS.Stroke
	Sidebar.BackgroundColor3 = COLORS.SidebarBg
	SidebarFix.BackgroundColor3 = COLORS.SidebarBg
	MinimizeBtn.BackgroundColor3 = COLORS.CardBg
	MinimizeBtn.TextColor3 = COLORS.TextMain
	CloseBtn.BackgroundColor3 = COLORS.CardBg
	CloseBtn.TextColor3 = COLORS.TextMain
	for _, fn in ipairs(themeUpdaters) do fn(COLORS, Config.AccentColor) end
	if refreshDropProtectUI then refreshDropProtectUI() end
end

applyAccent = function(color)
	if isUnloaded then return end
	Config.AccentColor = color
	LogoLabel.TextColor3 = color
	MiniLogoLabel.TextColor3 = color
	if FOVCircleStroke then FOVCircleStroke.Color = color end
	for _, fn in ipairs(themeUpdaters) do fn(COLORS, color) end
end

syncAllUIWithConfig = function()
	for _, fn in ipairs(uiSyncCallbacks) do fn() end
	if refreshDropProtectUI then refreshDropProtectUI() end
	if refreshWhitelistUI then refreshWhitelistUI() end
	updateWorldVisuals()
	refreshAllChams()
	if FOVCircleFrame then
		FOVCircleFrame.Size = UDim2.new(0, Config.AimFOV * 2, 0, Config.AimFOV * 2)
	end
end

local function CreateTab(tabName, assetId, customLayout)
	local TabButton = Instance.new("TextButton")
	TabButton.Size = UDim2.new(1, -12, 0, 44)
	TabButton.BackgroundColor3 = COLORS.CardBg
	TabButton.BackgroundTransparency = 1
	TabButton.Text = ""
	TabButton.AutoButtonColor = false
	TabButton.Parent = TabList
	Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 8)

	local Indicator = Instance.new("Frame")
	Indicator.Size = UDim2.new(0, 3, 0, 20)
	Indicator.Position = UDim2.new(0, -6, 0.5, -10)
	Indicator.BackgroundColor3 = Config.AccentColor
	Indicator.BorderSizePixel = 0
	Indicator.Visible = false
	Indicator.Parent = TabButton
	Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1, 0)

	local Icon = Instance.new("ImageLabel")
	Icon.Size = UDim2.new(0, 18, 0, 18)
	Icon.Position = UDim2.new(0.5, -9, 0, 5)
	Icon.BackgroundTransparency = 1
	Icon.Image = assetId
	Icon.ImageColor3 = COLORS.TextMuted
	Icon.Parent = TabButton

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, 0, 0, 14)
	Label.Position = UDim2.new(0, 0, 0, 25)
	Label.BackgroundTransparency = 1
	Label.Text = tabName
	Label.Font = Enum.Font.GothamBold
	Label.TextSize = 8.5
	Label.TextColor3 = COLORS.TextMuted
	Label.Parent = TabButton

	local Page = Instance.new("Frame")
	Page.Size = UDim2.new(1, 0, 1, 0)
	Page.BackgroundTransparency = 1
	Page.BorderSizePixel = 0
	Page.Visible = false
	Page.Parent = ContentArea

	if not customLayout then
		local Grid = Instance.new("UIGridLayout")
		Grid.CellSize = UDim2.new(0.485, 0, 0, CARD_HEIGHT)
		Grid.CellPadding = UDim2.new(0.03, 0, 0, 10)
		Grid.SortOrder = Enum.SortOrder.LayoutOrder
		Grid.Parent = Page
	end

	local tabObj = { Button = TabButton, Indicator = Indicator, Icon = Icon, Label = Label, Page = Page }

	local function selectTab()
		for _, t in ipairs(tabs) do
			t.Page.Visible = false
			t.Indicator.Visible = false
			t.Button.BackgroundTransparency = 1
			t.Icon.ImageColor3 = COLORS.TextMuted
			t.Label.TextColor3 = COLORS.TextMuted
		end
		Page.Visible = true
		Indicator.Visible = true
		TabButton.BackgroundTransparency = 0.4
		Icon.ImageColor3 = Config.AccentColor
		Label.TextColor3 = Config.AccentColor
	end

	table.insert(themeUpdaters, function(c, accent)
		TabButton.BackgroundColor3 = c.CardBg
		Indicator.BackgroundColor3 = accent
		if Page.Visible then
			Icon.ImageColor3 = accent
			Label.TextColor3 = accent
		else
			Icon.ImageColor3 = c.TextMuted
			Label.TextColor3 = c.TextMuted
		end
	end)

	TabButton.MouseButton1Click:Connect(selectTab)
	table.insert(tabs, tabObj)
	if #tabs == 1 then selectTab() end

	local function CreateModuleCard(title, initialBindName, subLabel, defaultState, onBindClick, callback)
		local state = defaultState
		local Card = Instance.new("Frame")
		Card.BackgroundColor3 = COLORS.CardBg
		Card.BorderSizePixel = 0
		Card.Parent = Page
		Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 8)

		local CardStroke = Instance.new("UIStroke")
		CardStroke.Color = COLORS.Stroke
		CardStroke.Thickness = 1
		CardStroke.Parent = Card

		local TitleLabel = Instance.new("TextLabel")
		TitleLabel.Size = UDim2.new(0.55, 0, 0, 22)
		TitleLabel.Position = UDim2.new(0, 12, 0, 7)
		TitleLabel.BackgroundTransparency = 1
		TitleLabel.Text = title
		TitleLabel.Font = Enum.Font.GothamBold
		TitleLabel.TextSize = 14
		TitleLabel.TextColor3 = COLORS.TextMain
		TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
		TitleLabel.Parent = Card

		local BindButton = Instance.new("TextButton")
		BindButton.Size = UDim2.new(0, 80, 0, 22)
		BindButton.Position = UDim2.new(1, -92, 0, 7)
		BindButton.BackgroundTransparency = 1
		BindButton.Text = initialBindName
		BindButton.Font = Enum.Font.GothamMedium
		BindButton.TextSize = 12
		BindButton.TextColor3 = COLORS.TextMuted
		BindButton.TextXAlignment = Enum.TextXAlignment.Right
		BindButton.Parent = Card

		BindButton.MouseButton1Click:Connect(function()
			activeBindTarget = { Button = BindButton, Callback = onBindClick }
			BindButton.Text = "..."
		end)

		local Divider = Instance.new("Frame")
		Divider.Size = UDim2.new(1, -24, 0, 1)
		Divider.Position = UDim2.new(0, 12, 0, 34)
		Divider.BackgroundColor3 = COLORS.Stroke
		Divider.BorderSizePixel = 0
		Divider.Parent = Card

		local OptionLabel = Instance.new("TextLabel")
		OptionLabel.Size = UDim2.new(0.7, 0, 0, 22)
		OptionLabel.Position = UDim2.new(0, 12, 0, 52)
		OptionLabel.BackgroundTransparency = 1
		OptionLabel.Text = subLabel
		OptionLabel.Font = Enum.Font.Gotham
		OptionLabel.TextSize = 12
		OptionLabel.TextColor3 = COLORS.TextMuted
		OptionLabel.TextXAlignment = Enum.TextXAlignment.Left
		OptionLabel.Parent = Card

		local ToggleBtn = Instance.new("TextButton")
		ToggleBtn.Size = UDim2.new(0, 36, 0, 18)
		ToggleBtn.Position = UDim2.new(1, -48, 0, 54)
		ToggleBtn.BackgroundColor3 = state and Config.AccentColor or COLORS.ToggleOff
		ToggleBtn.Text = ""
		ToggleBtn.AutoButtonColor = false
		ToggleBtn.Parent = Card
		Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

		local Circle = Instance.new("Frame")
		Circle.Size = UDim2.new(0, 14, 0, 14)
		Circle.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
		Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		Circle.BorderSizePixel = 0
		Circle.Parent = ToggleBtn
		Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

		table.insert(themeUpdaters, function(c, accent)
			Card.BackgroundColor3 = c.CardBg
			CardStroke.Color = c.Stroke
			Divider.BackgroundColor3 = c.Stroke
			TitleLabel.TextColor3 = c.TextMain
			BindButton.TextColor3 = c.TextMuted
			OptionLabel.TextColor3 = c.TextMuted
			ToggleBtn.BackgroundColor3 = state and accent or c.ToggleOff
		end)

		ToggleBtn.MouseButton1Click:Connect(function()
			state = not state
			local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(ToggleBtn, tweenInfo, { BackgroundColor3 = state and Config.AccentColor or COLORS.ToggleOff }):Play()
			TweenService:Create(Circle, tweenInfo, { Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) }):Play()
			if callback then callback(state) end
			saveConfig()
		end)
	end

	return { CreateModuleCard = CreateModuleCard, Page = Page }
end

