local function serializeEnum(enumItem)
	if typeof(enumItem) == "EnumItem" then
		return { EnumType = tostring(enumItem.EnumType), Name = enumItem.Name }
	end
	return nil
end

local function deserializeEnum(tbl, fallback)
	if type(tbl) == "table" and tbl.EnumType and tbl.Name then
		local enumRoot = Enum[tbl.EnumType]
		if enumRoot and enumRoot[tbl.Name] then
			return enumRoot[tbl.Name]
		end
	end
	return fallback
end

local function saveConfig()
	if not writefile then return end
	pcall(function()
		if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		elseif makefolder and not isfolder then
			makefolder(CONFIG_FOLDER)
		end

		local data = {
			PearlEnabled = Config.PearlEnabled,
			PearlKey = serializeEnum(Config.PearlKey),
			ToggleKey = serializeEnum(Config.ToggleKey),
			MenuTransparency = Config.MenuTransparency,
			AccentColor = { Config.AccentColor.R, Config.AccentColor.G, Config.AccentColor.B },
			WorldVisualsEnabled = Config.WorldVisualsEnabled,
			WorldGray = Config.WorldGray,
			WorldContrast = Config.WorldContrast,
			ChamsEnabled = Config.ChamsEnabled,
			ChamsFillAlpha = Config.ChamsFillAlpha,
			ChamsColor = { Config.ChamsColor.R, Config.ChamsColor.G, Config.ChamsColor.B },
			AmbientEnabled = Config.AmbientEnabled,
			AmbientColor = { Config.AmbientColor.R, Config.AmbientColor.G, Config.AmbientColor.B },
			CustomFOVEnabled = Config.CustomFOVEnabled,
			CameraFOV = Config.CameraFOV,
			DropProtectEnabled = Config.DropProtectEnabled,
			ProtectedSlots = Config.ProtectedSlots,
			AimEnabled = Config.AimEnabled,
			AimKey = serializeEnum(Config.AimKey),
			AimSmoothness = Config.AimSmoothness,
			AimFOV = Config.AimFOV,
			AimMaxDistance = Config.AimMaxDistance,
			AimFullyLock = Config.AimFullyLock,
			AimTargetPart = Config.AimTargetPart,
			AimShowFOV = Config.AimShowFOV,
			AimWallCheck = Config.AimWallCheck,
			AimIgnoreTeam = Config.AimIgnoreTeam,
			WhitelistedPlayers = Config.WhitelistedPlayers
		}

		writefile(CONFIG_FILE, HttpService:JSONEncode(data))
	end)
end

local function loadConfig()
	if not readfile or (isfile and not isfile(CONFIG_FILE)) then return end
	pcall(function()
		local raw = readfile(CONFIG_FILE)
		if not raw or raw == "" then return end
		local data = HttpService:JSONDecode(raw)
		if type(data) ~= "table" then return end

		if type(data.PearlEnabled) == "boolean" then Config.PearlEnabled = data.PearlEnabled end
		Config.PearlKey = deserializeEnum(data.PearlKey, Config.PearlKey)
		Config.ToggleKey = deserializeEnum(data.ToggleKey, Config.ToggleKey)
		if type(data.MenuTransparency) == "number" then Config.MenuTransparency = data.MenuTransparency end
		if type(data.AccentColor) == "table" and #data.AccentColor == 3 then
			Config.AccentColor = Color3.new(data.AccentColor[1], data.AccentColor[2], data.AccentColor[3])
		end
		if type(data.WorldVisualsEnabled) == "boolean" then Config.WorldVisualsEnabled = data.WorldVisualsEnabled end
		if type(data.WorldGray) == "number" then Config.WorldGray = data.WorldGray end
		if type(data.WorldContrast) == "number" then Config.WorldContrast = data.WorldContrast end
		if type(data.ChamsEnabled) == "boolean" then Config.ChamsEnabled = data.ChamsEnabled end
		if type(data.ChamsFillAlpha) == "number" then Config.ChamsFillAlpha = data.ChamsFillAlpha end
		if type(data.ChamsColor) == "table" and #data.ChamsColor == 3 then
			Config.ChamsColor = Color3.new(data.ChamsColor[1], data.ChamsColor[2], data.ChamsColor[3])
		end
		if type(data.AmbientEnabled) == "boolean" then Config.AmbientEnabled = data.AmbientEnabled end
		if type(data.AmbientColor) == "table" and #data.AmbientColor == 3 then
			Config.AmbientColor = Color3.new(data.AmbientColor[1], data.AmbientColor[2], data.AmbientColor[3])
		end
		if type(data.CustomFOVEnabled) == "boolean" then Config.CustomFOVEnabled = data.CustomFOVEnabled end
		if type(data.CameraFOV) == "number" then Config.CameraFOV = math.clamp(data.CameraFOV, 40, 140) end
		if type(data.DropProtectEnabled) == "boolean" then Config.DropProtectEnabled = data.DropProtectEnabled end
		if type(data.ProtectedSlots) == "table" then
			for i = 1, 9 do
				local v = data.ProtectedSlots[tostring(i)]
				if v == nil then v = data.ProtectedSlots[i] end
				if type(v) == "boolean" then Config.ProtectedSlots[i] = v end
			end
		end
		if type(data.AimEnabled) == "boolean" then Config.AimEnabled = data.AimEnabled end
		Config.AimKey = deserializeEnum(data.AimKey, Config.AimKey)
		if type(data.AimSmoothness) == "number" then Config.AimSmoothness = data.AimSmoothness end
		if type(data.AimFOV) == "number" then Config.AimFOV = math.clamp(data.AimFOV, 25, 800) end
		if type(data.AimMaxDistance) == "number" then Config.AimMaxDistance = math.clamp(data.AimMaxDistance, 10, 100) end
		if type(data.AimFullyLock) == "boolean" then Config.AimFullyLock = data.AimFullyLock end
		if data.AimTargetPart == "Head" or data.AimTargetPart == "Torso" then Config.AimTargetPart = data.AimTargetPart end
		if type(data.AimShowFOV) == "boolean" then Config.AimShowFOV = data.AimShowFOV end
		if type(data.AimWallCheck) == "boolean" then Config.AimWallCheck = data.AimWallCheck end
		if type(data.AimIgnoreTeam) == "boolean" then Config.AimIgnoreTeam = data.AimIgnoreTeam end
		if type(data.WhitelistedPlayers) == "table" then Config.WhitelistedPlayers = data.WhitelistedPlayers end
	end)
end

loadConfig()

