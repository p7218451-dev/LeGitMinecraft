	AimTopCard.BackgroundColor3 = c.CardBg
	AimStroke.Color = c.Stroke
	AimTitle.TextColor3 = c.TextMain
	AimSub.TextColor3 = c.TextMuted
	AimBindBtn.BackgroundColor3 = c.ToggleOff
	AimBindBtn.TextColor3 = c.TextMain
	AimSettingsCard.BackgroundColor3 = c.CardBg
	AimSettingsStroke.Color = c.Stroke
	MidDivider.BackgroundColor3 = c.Stroke
	targetLabel.TextColor3 = c.TextMuted
	WhitelistPanel.BackgroundColor3 = c.MainBg
	WLStroke.Color = c.Stroke
	WLHeader.TextColor3 = c.TextMuted
	WLScroll.ScrollBarImageColor3 = accent
	if ignoreTeamGear then ignoreTeamGear.TextColor3 = whitelistOpen and accent or c.TextMuted end
	refreshTargetPartButtons()
end)

