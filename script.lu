}

local function detectActiveSlot()
	local character = player.Character
	local equippedTool = character and character:FindFirstChildOfClass("Tool")
	if equippedTool then
		for _, attrName in ipairs({ "Slot", "SlotNumber", "HotbarSlot", "Order", "Index", "SlotIndex" }) do
			local attr = equippedTool:GetAttribute(attrName)
			if attr ~= nil and tonumber(attr) then
				local num = math.floor(tonumber(attr))
				if num >= 1 and num <= 9 then return num end
			end
		end
	end
	for _, holder in ipairs({ player, character }) do
		if holder then
			for _, attrName in ipairs({ "SelectedSlot", "CurrentSlot", "ActiveSlot", "HotbarSlot", "Slot" }) do
				local attr = holder:GetAttribute(attrName)
				if attr ~= nil and tonumber(attr) then
					local num = math.floor(tonumber(attr))
					if num >= 1 and num <= 9 then return num end
				end
			end
		end
	end
	return currentSelectedSlot
end

local function isCurrentSlotProtected()
	if isUnloaded or not Config.DropProtectEnabled then return false end
	local slot = detectActiveSlot()
	return slot ~= nil and Config.ProtectedSlots[slot] == true
end

task.spawn(function()
	task.wait(0.5)
	if not getconnections then return end
	pcall(function()
		for _, conn in ipairs(getconnections(UserInputService.InputBegan)) do
			if conn.Function and not isexecutorclosure(conn.Function) then
				local origFunc = conn.Function
				hookfunction(origFunc, function(input, gameProcessed, ...)
					if not isUnloaded and input and input.KeyCode == Enum.KeyCode.Q and isCurrentSlotProtected() then
						return
					end
					return origFunc(input, gameProcessed, ...)
				end)
			end
		end
	end)
end)

if hookmetamethod and getnamecallmethod and checkcaller then
	pcall(function()
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			local method = getnamecallmethod()
			if not isUnloaded and not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
				if isCurrentSlotProtected() and typeof(self) == "Instance" and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
					local remoteName = self.Name:lower()
					if remoteName:find("drop") or remoteName:find("throw") or remoteName:find("discard") or remoteName:find("trash") then
						return nil
					end
					for _, arg in ipairs({ ... }) do
						if type(arg) == "string" then
							local lowerArg = arg:lower()
							if lowerArg == "drop" or lowerArg == "dropitem" or lowerArg == "throw" or lowerArg == "discard" then
								return nil
							end
						end
					end
				end
			end
			return oldNamecall(self, ...)
		end)
	end)
end

pcall(function()
	ContextActionService:UnbindAction(DROP_ACTION_NAME)
	ContextActionService:BindActionAtPriority(
		DROP_ACTION_NAME,
		function(_, inputState)
			if isUnloaded then return Enum.ContextActionResult.Pass end
			if UserInputService:GetFocusedTextBox() ~= nil then return Enum.ContextActionResult.Pass end
			if inputState == Enum.UserInputState.Begin and isCurrentSlotProtected() then
				return Enum.ContextActionResult.Sink
			end
			return Enum.ContextActionResult.Pass
		end,
		false,
		2147483647,
		Enum.KeyCode.Q
	)
end)

local function isInputMatched(bind, input)
	if not bind or not input then return false end
	if typeof(bind) == "EnumItem" then
		if bind.EnumType == Enum.KeyCode and input.KeyCode == bind then return true end
		if bind.EnumType == Enum.UserInputType and input.UserInputType == bind then return true end
	end
	return false
end

local function isAimHeld()
	if isUnloaded or menuIsOpen or not Config.AimEnabled then return false end
	if UserInputService:GetFocusedTextBox() ~= nil then return false end
	local bind = Config.AimKey
	if typeof(bind) == "EnumItem" then
		if bind.EnumType == Enum.KeyCode then
			return UserInputService:IsKeyDown(bind)
		elseif bind.EnumType == Enum.UserInputType then
			return UserInputService:IsMouseButtonPressed(bind)
		end
	end
	return false
end

local function isPlayerIgnored(otherPlayer)
	if not otherPlayer or otherPlayer == player then return true end
	if Config.WhitelistedPlayers[otherPlayer.Name] == true or Config.WhitelistedPlayers[tostring(otherPlayer.UserId)] == true then
		return true
	end
	if Config.AimIgnoreTeam and player.Team and otherPlayer.Team and player.Team == otherPlayer.Team then
		return true
	end
	return false
end

local function getTargetPart(character)
	if not character then return nil end
	if Config.AimTargetPart == "Head" then
		return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	end
	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("Head")
end

local function hasLineOfSight(originPos, targetPart, targetCharacter)
	if not Config.AimWallCheck then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList = {}
	if player.Character then table.insert(ignoreList, player.Character) end
	if targetCharacter then table.insert(ignoreList, targetCharacter) end
	params.FilterDescendantsInstances = ignoreList
	return workspace:Raycast(originPos, targetPart.Position - originPos, params) == nil
end

local function buildTargetData(other, myRoot, ignoreFovAndWall)
	if isPlayerIgnored(other) or not other.Parent then return nil end
	local char = other.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not hum or hum.Health <= 0 then return nil end
	local part = getTargetPart(char)
	if not part then return nil end
	if not ignoreFovAndWall and (part.Position - myRoot.Position).Magnitude > Config.AimMaxDistance then
		return nil
	end
	local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
	if not ignoreFovAndWall then
		if not onScreen or screenPos.Z <= 0 then return nil end
		if not hasLineOfSight(camera.CFrame.Position, part, char) then return nil end
	elseif screenPos.Z <= 0 then
		return nil
	end
	return { Player = other, Part = part, ScreenPos = Vector2.new(screenPos.X, screenPos.Y) }
end

local function findBestAimTarget()
	camera = workspace.CurrentCamera
	if not camera then return nil, nil end
	local myChar = player.Character
	local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
	if not myRoot then return nil, nil end
	local screenCenter = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)

	if Config.AimFullyLock and lockedTargetPlayer then
		local lockedData = buildTargetData(lockedTargetPlayer, myRoot, true)
		if lockedData then return lockedData, screenCenter end
		lockedTargetPlayer = nil
		return nil, screenCenter
	end

	local bestTarget, bestScreenDist = nil, Config.AimFOV
	for _, other in ipairs(Players:GetPlayers()) do
		local data = buildTargetData(other, myRoot, false)
		if data then
			local d = (data.ScreenPos - screenCenter).Magnitude
			if d <= bestScreenDist then
				bestScreenDist = d
				bestTarget = data
			end
		end
	end

	if Config.AimFullyLock and bestTarget then
		lockedTargetPlayer = bestTarget.Player
	end
	return bestTarget, screenCenter
end

local function moveMouseRelative(dx, dy)
	if math.abs(dx) < 0.05 and math.abs(dy) < 0.05 then return end
	if typeof(mousemoverel) == "function" then
		pcall(mousemoverel, dx, dy)
	elseif VirtualInputManager then
		local mouseLoc = UserInputService:GetMouseLocation()
		pcall(function()
			VirtualInputManager:SendMouseMoveEvent(mouseLoc.X + dx, mouseLoc.Y + dy, game)
		end)
	end
end

local worldEffect = Lighting:FindFirstChild("LeGit_ColorCorrection")
if not worldEffect or not worldEffect:IsA("ColorCorrectionEffect") then
	worldEffect = Instance.new("ColorCorrectionEffect")
	worldEffect.Name = "LeGit_ColorCorrection"
	worldEffect.Parent = Lighting
end

local origAmbient = Lighting.Ambient
local origOutdoorAmbient = Lighting.OutdoorAmbient

updateAmbientLighting = function()
	if isUnloaded or not Config.AmbientEnabled then
		pcall(function()
			Lighting.Ambient = origAmbient
			Lighting.OutdoorAmbient = origOutdoorAmbient
		end)
		return
	end
	pcall(function()
		Lighting.Ambient = Config.AmbientColor
		Lighting.OutdoorAmbient = Config.AmbientColor
	end)
end

local function updateWorldVisuals()
	if isUnloaded then
		if worldEffect then worldEffect.Enabled = false end
		updateAmbientLighting()
		return
	end
	if Config.WorldVisualsEnabled then
		worldEffect.Enabled = true
		worldEffect.Saturation = -Config.WorldGray
		worldEffect.Contrast = Config.WorldContrast
		worldEffect.Brightness = 0
	else
		worldEffect.Enabled = false
	end
	updateAmbientLighting()
end
updateWorldVisuals()

local function updateChamsForCharacter(character)
	if not character then return end
	local highlight = character:FindFirstChild("LeGitChams")
	if not isUnloaded and Config.ChamsEnabled then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "LeGitChams"
			highlight.Parent = character
		end
		highlight.Adornee = character
		highlight.FillColor = Config.ChamsColor
		highlight.FillTransparency = Config.ChamsFillAlpha / 100
		highlight.OutlineTransparency = 1
	elseif highlight then
		highlight:Destroy()
	end
end

local function refreshAllChams()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then updateChamsForCharacter(p.Character) end
	end
end

local function clearAllVisualHighlights()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			local hl = p.Character:FindFirstChild("LeGitChams")
			if hl then hl:Destroy() end
		end
	end
end

trackConnection(Players.PlayerAdded:Connect(function(p)
	if isUnloaded then return end
	if refreshWhitelistUI then refreshWhitelistUI() end
	trackConnection(p.CharacterAdded:Connect(function(char)
		if isUnloaded then return end
		task.wait(1)
		updateChamsForCharacter(char)
	end))
end))

trackConnection(Players.PlayerRemoving:Connect(function()
	if isUnloaded then return end
	task.defer(function()
		if refreshWhitelistUI then refreshWhitelistUI() end
	end))
end))

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= player then
		trackConnection(p.CharacterAdded:Connect(function(char)
			if isUnloaded then return end
			task.wait(1)
			updateChamsForCharacter(char)
		end))
		if p.Character then updateChamsForCharacter(p.Character) end
	end
end

