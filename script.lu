local function serverRejoin()
	if isUnloaded then return end
	if #Players:GetPlayers() <= 1 then
		player:Kick("\nПерезаход на тот же сервер...")
		task.wait(1)
		TeleportService:Teleport(game.PlaceId, player)
	else
		TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
	end
end

local function serverHop()
	if isUnloaded then return end
	local success, result = pcall(function()
		return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
	end)
	if success and result and result.data then
		local servers = {}
		for _, s in ipairs(result.data) do
			if type(s) == "table" and s.maxPlayers and s.playing and s.id and s.playing < s.maxPlayers and s.id ~= game.JobId then
				table.insert(servers, s.id)
			end
		end
		if #servers > 0 then
			TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
		else
			player:Kick("Не удалось найти свободный сервер для Server Hop.")
		end
	else
		player:Kick("Ошибка получения списка серверов.")
	end
end

