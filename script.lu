-- Вспомогательные виджеты
local function makeCustomSlider(parent, name, xPos, yPos, widthScale, initialVal, minVal, maxVal, callback, zIndexBase, suffixText)
	local zBase = zIndexBase or 6
	local minBound = minVal or 0
	local maxBound = maxVal or 100
	local clampedInit = math.clamp(initialVal, minBound, maxBound)
	local initRatio = (clampedInit - minBound) / (maxBound - minBound)
	local suf = suffixText or ""

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(widthScale, -12, 0, 14)
	lbl.Position = UDim2.new(xPos, 6, 0, yPos)
	lbl.BackgroundTransparency = 1
	lbl.Text = name .. ": " .. math.floor(clampedInit) .. suf
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize, lbl.TextColor3 = 10.5, COLORS.TextMuted
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = zBase
	lbl.Parent = parent

	local track = Instance.new("Frame")
	track.Size = UDim2.new(widthScale, -12, 0, 5)
	track.Position = UDim2.new(xPos, 6, 0, yPos + 16)
	track.BackgroundColor3 = COLORS.ToggleOff
	track.BorderSizePixel = 0
	track.ZIndex = zBase
	track.Parent = parent
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(initRatio, 0, 1, 0)
	fill.BackgroundColor3 = Config.AccentColor
	fill.BorderSizePixel = 0
	fill.ZIndex = zBase
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local sliding = false
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end
	end)
	trackConnection(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and sliding then
			sliding = false
			saveConfig()
		end
	end))
	trackConnection(UserInputService.InputChanged:Connect(function(input)
		if sliding and not isUnloaded and input.UserInputType == Enum.UserInputType.MouseMovement then
			local mousePos = UserInputService:GetMouseLocation().X
			local trackPos = track.AbsolutePosition.X
			local trackSize = track.AbsoluteSize.X
			if trackSize > 0 then
				local p = math.clamp((mousePos - trackPos) / trackSize, 0, 1)
				fill.Size = UDim2.new(p, 0, 1, 0)
				local realVal = math.floor(minBound + p * (maxBound - minBound) + 0.5)
				lbl.Text = name .. ": " .. realVal .. suf
				callback(realVal)
			end
		end
	end))

	table.insert(themeUpdaters, function(c, accent)
		lbl.TextColor3 = c.TextMuted
		track.BackgroundColor3 = c.ToggleOff
		fill.BackgroundColor3 = accent
	end)

	return function(val)
		local cVal = math.clamp(val, minBound, maxBound)
		fill.Size = UDim2.new((cVal - minBound) / (maxBound - minBound), 0, 1, 0)
		lbl.Text = name .. ": " .. math.floor(cVal) .. suf
	end
end

local function makeAimColToggle(parent, labelText, xPos, yPos, widthScale, initialState, onChange, highlightDanger, hasGear)
	local wScale = widthScale or 0.48
	local st = initialState
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(wScale * 0.65, 0, 0, 18)
	lbl.Position = UDim2.new(xPos, 8, 0, yPos)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelText
	lbl.Font = highlightDanger and Enum.Font.GothamBold or Enum.Font.Gotham
	lbl.TextSize = 11
	lbl.TextColor3 = highlightDanger and Color3.fromRGB(255, 95, 95) or COLORS.TextMuted
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = parent

	local gearBtn = nil
	if hasGear then
		gearBtn = Instance.new("TextButton")
		gearBtn.Size = UDim2.new(0, 22, 0, 18)
		gearBtn.Position = UDim2.new(xPos + wScale, -68, 0, yPos)
		gearBtn.BackgroundTransparency = 1
		gearBtn.Text = "⚙"
		gearBtn.Font = Enum.Font.GothamBold
		gearBtn.TextSize = 14
		gearBtn.TextColor3 = COLORS.TextMuted
		gearBtn.Parent = parent
	end

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 34, 0, 16)
	btn.Position = UDim2.new(xPos + wScale, -42, 0, yPos + 1)
	btn.BackgroundColor3 = st and (highlightDanger and Color3.fromRGB(235, 65, 65) or Config.AccentColor) or COLORS.ToggleOff
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 12, 0, 12)
	dot.Position = st and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
	dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	dot.BorderSizePixel = 0
	dot.Parent = btn
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	btn.MouseButton1Click:Connect(function()
		st = not st
		local activeCol = highlightDanger and Color3.fromRGB(235, 65, 65) or Config.AccentColor
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = st and activeCol or COLORS.ToggleOff }):Play()
		TweenService:Create(dot, TweenInfo.new(0.15), { Position = st and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6) }):Play()
		onChange(st)
		saveConfig()
	end)

	table.insert(themeUpdaters, function(c, accent)
		if not highlightDanger then lbl.TextColor3 = c.TextMuted end
		local activeCol = highlightDanger and Color3.fromRGB(235, 65, 65) or accent
		btn.BackgroundColor3 = st and activeCol or c.ToggleOff
	end)

	return function(newVal)
		st = newVal
		local activeCol = highlightDanger and Color3.fromRGB(235, 65, 65) or Config.AccentColor
		btn.BackgroundColor3 = st and activeCol or COLORS.ToggleOff
		dot.Position = st and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
	end, gearBtn
end

local function makeColorPickerBox(parent, titleText, xPos, yPos, widthScale, initialColor, onColorChange)
	local h, s, v = Color3.toHSV(initialColor)

	local box = Instance.new("Frame")
	box.Size = UDim2.new(widthScale, -12, 0, 108)
	box.Position = UDim2.new(xPos, 6, 0, yPos)
	box.BackgroundColor3 = COLORS.MainBg
	box.BorderSizePixel = 0
	box.ZIndex = 4
	box.Parent = parent
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)

	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = COLORS.Stroke
	boxStroke.Thickness = 1
	boxStroke.Parent = box

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(0.65, 0, 0, 16)
	titleLbl.Position = UDim2.new(0, 8, 0, 4)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = titleText
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 10.5
	titleLbl.TextColor3 = COLORS.TextMain
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.ZIndex = 5
	titleLbl.Parent = box

	local preview = Instance.new("Frame")
	preview.Size = UDim2.new(0, 34, 0, 14)
	preview.Position = UDim2.new(1, -42, 0, 5)
	preview.BackgroundColor3 = initialColor
	preview.BorderSizePixel = 0
	preview.ZIndex = 5
	preview.Parent = box
	Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 4)

	local svPad = Instance.new("Frame")
	svPad.Size = UDim2.new(1, -16, 0, 56)
	svPad.Position = UDim2.new(0, 8, 0, 23)
	svPad.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
	svPad.BorderSizePixel = 0
	svPad.ZIndex = 5
	svPad.Parent = box
	Instance.new("UICorner", svPad).CornerRadius = UDim.new(0, 5)

	local satGrad = Instance.new("UIGradient")
	satGrad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255))
	satGrad.Transparency = NumberSequence.new(0, 1)
	satGrad.Parent = svPad

	local valOverlay = Instance.new("Frame")
	valOverlay.Size = UDim2.new(1, 0, 1, 0)
	valOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	valOverlay.BorderSizePixel = 0
	valOverlay.ZIndex = 6
	valOverlay.Parent = svPad
	Instance.new("UICorner", valOverlay).CornerRadius = UDim.new(0, 5)

	local valGrad = Instance.new("UIGradient")
	valGrad.Rotation = 90
	valGrad.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(0, 0, 0))
	valGrad.Transparency = NumberSequence.new(1, 0)
	valGrad.Parent = valOverlay

	local svCursor = Instance.new("Frame")
	svCursor.Size = UDim2.new(0, 10, 0, 10)
	svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
	svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
	svCursor.BackgroundTransparency = 1
	svCursor.ZIndex = 7
	svCursor.Parent = svPad
	Instance.new("UICorner", svCursor).CornerRadius = UDim.new(1, 0)
	local svCursorStroke = Instance.new("UIStroke")
	svCursorStroke.Color = Color3.fromRGB(255, 255, 255)
	svCursorStroke.Thickness = 2
	svCursorStroke.Parent = svCursor

	local hueBar = Instance.new("Frame")
	hueBar.Size = UDim2.new(1, -16, 0, 9)
	hueBar.Position = UDim2.new(0, 8, 0, 88)
	hueBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	hueBar.BorderSizePixel = 0
	hueBar.ZIndex = 5
	hueBar.Parent = box
	Instance.new("UICorner", hueBar).CornerRadius = UDim.new(1, 0)

	local hueGrad = Instance.new("UIGradient")
	hueGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
		ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
		ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
		ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
	})
	hueGrad.Parent = hueBar

	local hueCursor = Instance.new("Frame")
	hueCursor.Size = UDim2.new(0, 4, 1, 2)
	hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
	hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
	hueCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	hueCursor.BorderSizePixel = 0
	hueCursor.ZIndex = 7
	hueCursor.Parent = hueBar
	Instance.new("UICorner", hueCursor).CornerRadius = UDim.new(1, 0)

	local function applyHSV()
		local col = Color3.fromHSV(h, s, v)
		svPad.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		preview.BackgroundColor3 = col
		svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
		onColorChange(col)
	end

	local dragSV, dragHue = false, false
	valOverlay.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragSV = true end
	end)
	hueBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragHue = true end
	end)
	trackConnection(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and (dragSV or dragHue) then
			dragSV = false
			dragHue = false
			saveConfig()
		end
	end))
	trackConnection(UserInputService.InputChanged:Connect(function(input)
		if isUnloaded or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local mouse = UserInputService:GetMouseLocation()
		if dragSV then
			local pPos, pSize = svPad.AbsolutePosition, svPad.AbsoluteSize
			if pSize.X > 0 and pSize.Y > 0 then
				s = math.clamp((mouse.X - pPos.X) / pSize.X, 0, 1)
				v = 1 - math.clamp((mouse.Y - pPos.Y) / pSize.Y, 0, 1)
				applyHSV()
			end
		elseif dragHue then
			local hPos, hSize = hueBar.AbsolutePosition, hueBar.AbsoluteSize
			if hSize.X > 0 then
				h = math.clamp((mouse.X - hPos.X) / hSize.X, 0, 1)
				applyHSV()
			end
		end
	end))

	table.insert(themeUpdaters, function(c)
		box.BackgroundColor3 = c.MainBg
		boxStroke.Color = c.Stroke
		titleLbl.TextColor3 = c.TextMain
	end)

	return function(newCol)
		h, s, v = Color3.toHSV(newCol)
		svPad.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		preview.BackgroundColor3 = newCol
		svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
	end
end

